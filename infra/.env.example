DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,proxy
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8080

MYSQL_DATABASE=modern_sis
MYSQL_USER=modern_sis
MYSQL_PASSWORD=modern_sis
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

DEV_DB_PORT=3313
DEV_HTTP_PORT=8080

# Optional Phase 3.3 LTI local settings. Keep real keys and secrets out of source control.
LTI_PLATFORM_ISSUER_ALLOWLIST=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_PRIVATE_KEY_FILE=./local-secrets/lti_private.pem
LTI_PUBLIC_KEY_FILE=./local-secrets/lti_public.pem
LTI_KEY_ID=modern-sis-lti-local
LTI_PLATFORM_AUTH_LOGIN_URL=
LTI_PLATFORM_JWKS_URL=
LTI_LAUNCH_SUCCESS_REDIRECT_BASE=
