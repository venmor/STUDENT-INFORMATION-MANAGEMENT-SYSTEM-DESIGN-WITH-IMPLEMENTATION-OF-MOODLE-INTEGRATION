MOODLE_HTTP_PORT=8090
MOODLE_HOST=
MOODLE_SITE_NAME=Student Information System Moodle
MOODLE_USERNAME=admin
MOODLE_PASSWORD=ChangeMe123!
MOODLE_EMAIL=admin@example.com

MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle
MOODLE_DB_ROOT_PASSWORD=root

MOODLE_BASE_URL=http://127.0.0.1:8090
MOODLE_WS_TOKEN=
MOODLE_DEFAULT_CATEGORY_ID=1
MOODLE_STUDENT_ROLE_ID=5
MOODLE_EDITING_TEACHER_ROLE_ID=3
MOODLE_INSTITUTION=Student Information System
MOODLE_GRADE_SOURCE=modern_sis
MOODLE_SYNC_TIMEOUT=10
# Step 3.4 uses the same Moodle REST endpoint and token for
# ingest_moodle_engagement. Add core_enrol_get_enrolled_users to the Moodle
# custom external service before running the optional live ingestion check.

# Step 3.3 Lane B LTI v1.3 tool-provider settings.
# Do not commit real private keys. For local work, place generated keys in an
# untracked file path and point LTI_PRIVATE_KEY_FILE / LTI_PUBLIC_KEY_FILE at it.
LTI_PLATFORM_ISSUER_ALLOWLIST=http://127.0.0.1:8090
LTI_CLIENT_ID=replace-with-moodle-client-id
LTI_DEPLOYMENT_ID=replace-with-moodle-deployment-id
LTI_PRIVATE_KEY=
LTI_PRIVATE_KEY_FILE=./local-secrets/lti_private.pem
LTI_PUBLIC_KEY=
LTI_PUBLIC_KEY_FILE=./local-secrets/lti_public.pem
LTI_KEY_ID=modern-sis-lti-local
LTI_PLATFORM_AUTH_LOGIN_URL=http://127.0.0.1:8090/mod/lti/auth.php
LTI_PLATFORM_AUTH_TOKEN_URL=http://127.0.0.1:8090/mod/lti/token.php
LTI_PLATFORM_JWKS_URL=http://127.0.0.1:8090/mod/lti/certs.php
LTI_PLATFORM_PUBLIC_KEY=
LTI_PLATFORM_PUBLIC_KEY_FILE=
LTI_LAUNCH_SUCCESS_REDIRECT_BASE=
LTI_STATE_TTL_SECONDS=600
LTI_SESSION_TTL_SECONDS=3600
LTI_SESSION_COOKIE_NAME=sis_lti_session
LTI_SESSION_COOKIE_SECURE=false
LTI_SESSION_COOKIE_SAMESITE=Lax

# Phase 4.1 analytics and vector-store foundation.
QDRANT_HTTP_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=modern_sis_knowledge
KNOWLEDGE_VECTOR_STORE_PROVIDER=qdrant
EMBEDDING_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=64
KNOWLEDGE_CHUNK_TOKENS=512
KNOWLEDGE_CHUNK_OVERLAP=64

# Phase 4.2 student service co-pilot.
# Set AI_PROVIDER=openai_compatible and supply OPENAI_API_KEY to use a live LLM.
# Default: deterministic (no API key needed, safe for local dev/CI/tests).
AI_PROVIDER=deterministic
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_CONTEXT_CHUNKS=5
AI_MAX_QUESTION_LENGTH=1000
COPILOT_LOW_CONFIDENCE_THRESHOLD=0.2
